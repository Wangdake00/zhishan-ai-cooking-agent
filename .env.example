# ========== 服务基础配置（可选，均有默认值） ==========
# API_HOST=127.0.0.1
# API_PORT=8001
# DEBUG=false

# ========== CORS 跨域白名单 ==========
# 逗号分隔的前端来源；与 allow_credentials=True 组合时禁止使用 "*"
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========== 阿里云百炼（大模型服务） ==========
# 获取方式：https://bailian.console.aliyun.com/ → 模型广场 → API-KEY 管理
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 百炼 OpenAI 兼容模式 endpoint，一般不用改
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== Agent 模型配置 ==========
# 对话/Query 改写使用的大模型
LLM_MODEL=qwen3.8-flash
# LLM 超时（秒）
LLM_TIMEOUT_SECONDS=120
# LLM 最大重试次数
LLM_MAX_RETRIES=2

# ========== 长会话上下文治理 ==========
# 总开关（关闭后等同旧行为：不裁剪/不摘要/不做历史图片治理）
CONTEXT_MANAGE_ENABLED=true
# 触发阈值：对话轮数或估算 token 先到先触发
CONTEXT_MAX_TURNS=10
CONTEXT_MAX_TOKENS=6000
# 裁剪窗口：保留首轮 + 最近 N 轮（按 Human + 对应 AI 成轮切分）
CONTEXT_KEEP_RECENT_TURNS=8
CONTEXT_KEEP_FIRST_TURN=true
# 摘要（同步增量摘要；任何失败自动降级为不裁剪，不中断主回答）
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MAX_CHARS=600
CONTEXT_SUMMARY_INPUT_MAX_CHARS=8000
CONTEXT_SUMMARY_TIMEOUT_SECONDS=20
# 硬上限：摘要失败且仍超限时，退化为无摘要滑动窗口
CONTEXT_HARD_LIMIT_TOKENS=20000
# 历史图片治理：历史轮次图片替换为占位文本，仅保留最近 N 张历史图 + 当前轮图
CONTEXT_IMAGE_GOVERN_ENABLED=true
CONTEXT_IMAGE_KEEP_RECENT=1
# 图片持久化方式：oss_key（默认，消息只存对象键，读取时重签 URL）| base64（旧行为）
CONTEXT_IMAGE_PERSIST=oss_key
# token 粗估系数（中文字符/其他字符，不引入 tokenizer 依赖）
CONTEXT_TOKEN_CHARS_PER_TOKEN_ZH=1.3
CONTEXT_TOKEN_CHARS_PER_TOKEN_OTHER=4.0
CONTEXT_IMAGE_TOKEN_ESTIMATE=1280
# 跨会话长期偏好记忆（显式偏好抽取 + 每轮注入 system prompt）
PREFERENCE_MEMORY_ENABLED=true
PREFERENCE_MAX_ITEMS=20

# ========== RAG / ChromaDB 向量检索 ==========
# ChromaDB 持久化存储路径
CHROMA_DB_DIR=db/chroma_data
# ChromaDB 集合名称
CHROMA_COLLECTION_NAME=recipes
# Embedding 向量化模型（DashScope）
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# Embedding 批量大小
EMBEDDING_BATCH_SIZE=10
# Rerank 重排模型（DashScope）
RERANK_MODEL=qwen3.7-text-rerank
# 向量召回 Top-K 数量
RAG_TOP_K=10
# Rerank 后返回 Top-N 数量
RAG_TOP_N=5

# ========== 语音识别（STT） ==========
# DashScope Qwen 实时语音识别模型（语音转文字）
# 复用上方 DASHSCOPE_API_KEY，无需额外密钥
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming

# ========== Tavily（Agent 联网搜索工具） ==========
# 获取方式：https://tavily.com/ → 注册 → API Keys
TAVILY_API_KEY=your_tavily_api_key_here

# ========== JWT 认证 ==========
# 用于用户登录 token 签名，生产环境务必更换为随机长字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=7

# ========== PostgreSQL 数据库 ==========
# 启动方式：docker compose up -d（自动读取下方 POSTGRES_* 环境变量）
# 本地开发保持 127.0.0.1；Docker 部署时 compose 会自动覆盖为服务名 postgres，无需修改
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chief
POSTGRES_PASSWORD=chief123
POSTGRES_DB=ai_chef
# 业务表由 Alembic 管理迁移：uv run alembic upgrade head
# LangGraph checkpoint 表由 AsyncPostgresSaver 自动创建

# ========== 阿里云 OSS（图片存储） ==========
# 获取方式：https://ram.console.aliyun.com/ → AccessKey 管理
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
# Bucket 名称（创建 bucket 时自定义）
OSS_BUCKET=your_bucket_name
# Region 和 Endpoint 必须对应同一个地域
# 常见地域：cn-hangzhou / cn-shanghai / cn-beijing / cn-shenzhen
OSS_REGION=cn-shenzhen
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
