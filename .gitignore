# ========== 环境变量（含密钥，严禁提交） ==========
.env
.env.*
!.env.example

# ========== Python ==========
# 虚拟环境
.venv/
venv/
env/
ENV/

# 字节码缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包/分发
build/
dist/
*.egg-info/
*.egg

# 测试/覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/

# ========== 数据库（本地数据，不提交） ==========
*.db
*.sqlite
*.sqlite3
app/db/*.db

# ChromaDB 向量数据库持久化数据
app/db/chroma_data/

# ========== 前端构建产物 ==========
# Next.js 构建缓存与导出
frontend/.next/
frontend/out/

# 部署到后端的静态资源（由前端构建生成）
app/static/

# ========== 依赖目录 ==========
frontend/node_modules/

# ========== 日志 ==========
*.log
logs/

# ========== IDE / 编辑器 ==========
.idea/
.vscode/
*.swp
*.swo

# ========== 操作系统 ==========
.DS_Store
Thumbs.db
desktop.ini

# ========== 其他 ==========
*.bak
*.tmp
