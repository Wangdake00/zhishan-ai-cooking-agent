# ============================================================
# 构建上下文排除清单：镜像只包含运行所需的最小文件集
# 硬性要求：.env 及任何密钥绝不能进入镜像层
# ============================================================

# ---------- 密钥与环境变量（严禁进入镜像） ----------
.env
.env.*
!.env.example
**/.env
**/.env.*

# ---------- 版本控制 ----------
.git
.gitignore
.gitattributes

# ---------- Python 运行时无关文件 ----------
.venv/
venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 本地数据（由命名卷 / 运行时生成） ----------
db/
identifier.sqlite
*.db
*.sqlite
*.sqlite3

# ---------- 前端：依赖与构建产物（均在镜像内重新生成） ----------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# ---------- 后端托管目录：必须由前端构建阶段生成，禁止从宿主机 COPY ----------
app/static/

# ---------- 测试 / 调试产物（本地开发用，不进镜像） ----------
tests/
test_*.py
graph_mermaid.mmd
graph_structure.txt
views/
**/*.png
**/*.jpg

# ---------- IDE / 系统文件 ----------
.idea/
.vscode/
.trae/
**/.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- Docker 自身 ----------
Dockerfile
docker-compose.yml
.dockerignore
